# Copy to .env and replace every CHANGE_ME value before starting the API.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Local development default matches infra/docker-compose.yml
DATABASE_URL=postgres://mizigox:mizigox@localhost:5432/mizigox

# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Created on first API boot when missing. Used only for local/dev seeding.
SEED_ADMIN_EMAIL=admin@mizigox.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_ADMIN_FIRST_NAME=Kasasira
SEED_ADMIN_LAST_NAME=Admin
SEED_ON_BOOT=true

# Tracking freshness and location ingest (seconds unless noted)
TRACKING_LIVE_SECONDS=60
TRACKING_RECENT_SECONDS=300
TRACKING_STALE_SECONDS=900
TRACKING_MAX_FUTURE_SKEW_SECONDS=300
TRACKING_MAX_AGE_SECONDS=86400
TRACKING_LOCATION_RATE_MAX=60
TRACKING_LOCATION_RATE_WINDOW_MS=60000

# Map rendering: none | osm | mapbox | google. OSM needs no key.
MAP_PROVIDER=osm
# MAPBOX_ACCESS_TOKEN=
# GOOGLE_MAPS_API_KEY=
# VITE_MAP_PROVIDER=osm
# VITE_MAPBOX_ACCESS_TOKEN=
# VITE_GOOGLE_MAPS_API_KEY=

# Payment providers. MANUAL records offline cash/bank/mobile-money for later confirmation.
# Do not set webhook/gateway secrets unless a real provider is connected.
PAYMENT_DEFAULT_PROVIDER=MANUAL
# PAYMENT_GATEWAY_BASE_URL=
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Notifications. Development defaults never send real email, SMS, or push.
NOTIFICATION_EMAIL_PROVIDER=log
NOTIFICATION_SMS_PROVIDER=log
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=5
# SMTP_URL=
# SMTP_FROM=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# AWS_SES_REGION=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# SMS_API_BASE_URL=
# SMS_API_KEY=
# SMS_FROM=
# PUSH_FCM_SERVER_KEY=
