# Copy to .env and replace every CHANGE_ME value before starting the API.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Local development default matches infra/docker-compose.yml
DATABASE_URL=postgres://mizigox:mizigox@localhost:5432/mizigox

# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Created on first API boot when missing. Used only for local/dev seeding.
SEED_ADMIN_EMAIL=admin@mizigox.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_ADMIN_FIRST_NAME=Kasasira
SEED_ADMIN_LAST_NAME=Admin
SEED_ON_BOOT=true

# Tracking freshness and location ingest (seconds unless noted)
TRACKING_LIVE_SECONDS=60
TRACKING_RECENT_SECONDS=300
TRACKING_STALE_SECONDS=900
TRACKING_MAX_FUTURE_SKEW_SECONDS=300
TRACKING_MAX_AGE_SECONDS=86400
TRACKING_LOCATION_RATE_MAX=60
TRACKING_LOCATION_RATE_WINDOW_MS=60000

# Map rendering: none | osm | mapbox | google. OSM needs no key.
MAP_PROVIDER=osm
# MAPBOX_ACCESS_TOKEN=
# GOOGLE_MAPS_API_KEY=
# VITE_MAP_PROVIDER=osm
# VITE_MAPBOX_ACCESS_TOKEN=
# VITE_GOOGLE_MAPS_API_KEY=
