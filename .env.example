# Copy to `.env` and replace every CHANGE_ME value before starting the API.
# Never commit `.env`, `.env.production`, `.env.staging`, passwords, or API keys.

# -----------------------------------------------------------------------------
# Environment
# development | test | production  (NODE_ENV)
# development | staging | production (APP_ENV, optional; production-like rules
# apply when NODE_ENV=production or APP_ENV=production)
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info

# Public URLs. Production placeholders (do not purchase/configure automatically):
# APP_PUBLIC_URL=https://app.mizigox.com
# API_PUBLIC_URL=https://api.mizigox.com
WEB_ORIGIN=http://localhost:5173
# Extra browser origins, comma-separated (staging previews, etc.)
# WEB_ORIGINS=https://app.mizigox.com

# Local development default matches infra/docker-compose.yml — not for production.
DATABASE_URL=postgres://mizigox:mizigox@localhost:5432/mizigox
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Production requires COOKIE_SECURE=true (HTTPS). Split app/api hosts need
# COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Created on first API boot when missing. Local/dev seeding only.
SEED_ADMIN_EMAIL=admin@mizigox.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_ADMIN_FIRST_NAME=Kasasira
SEED_ADMIN_LAST_NAME=Admin
SEED_ON_BOOT=true
MIGRATE_ON_BOOT=true

# Tracking freshness and location ingest (seconds unless noted)
TRACKING_LIVE_SECONDS=60
TRACKING_RECENT_SECONDS=300
TRACKING_STALE_SECONDS=900
TRACKING_MAX_FUTURE_SKEW_SECONDS=300
TRACKING_MAX_AGE_SECONDS=86400
TRACKING_LOCATION_RATE_MAX=60
TRACKING_LOCATION_RATE_WINDOW_MS=60000

# Map rendering: none | osm | mapbox | google. OSM needs no key.
MAP_PROVIDER=osm
# MAPBOX_ACCESS_TOKEN=
# GOOGLE_MAPS_API_KEY=
# VITE_MAP_PROVIDER=osm
# VITE_MAPBOX_ACCESS_TOKEN=
# VITE_GOOGLE_MAPS_API_KEY=

# Frontend API base. Leave unset in local Vite (proxy /api → API_PORT).
# Production split-domain example:
# VITE_API_BASE_URL=https://api.mizigox.com/api/v1

# Payment providers. MANUAL records offline cash/bank/mobile-money for later confirmation.
# Payment provider integration remains required before accepting real customer payments.
# Do not set webhook/gateway secrets unless a real provider is connected.
# Do not simulate live payment success in production.
PAYMENT_DEFAULT_PROVIDER=MANUAL
# PAYMENT_GATEWAY_BASE_URL=
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Notifications. Development defaults never send real email, SMS, or push.
NOTIFICATION_EMAIL_PROVIDER=log
NOTIFICATION_SMS_PROVIDER=log
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=5
# SMTP_URL=
# SMTP_FROM=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# AWS_SES_REGION=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# SMS_API_BASE_URL=
# SMS_API_KEY=
# SMS_FROM=
# PUSH_FCM_SERVER_KEY=

# Proof-of-delivery attachments. local writes under STORAGE_LOCAL_DIR. none rejects uploads.
# s3 requires S3_BUCKET + S3_REGION; the S3 adapter is not wired until a client is connected.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=var/storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Error monitoring. Leave empty until a provider account exists.
# SENTRY_DSN=
